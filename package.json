{
  "name": "saucedemo-ui-automation",
  "version": "1.0.0",
  "private": true,
  "description": "UI automation tests for saucedemo.com (login, cart and E2E checkout) using Playwright with the Page Object Model.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test --config=config/playwright.config.ts",
    "test:smoke": "playwright test --config=config/playwright.config.ts --grep @smoke",
    "test:chromium": "playwright test --config=config/playwright.config.ts --project=chromium",
    "test:ui": "playwright test --config=config/playwright.config.ts --ui",
    "test:headed": "playwright test --config=config/playwright.config.ts --project=chromium --headed",
    "test:debug": "playwright test --config=config/playwright.config.ts --project=chromium --debug",
    "report": "playwright show-report playwright-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "dotenv": "^16.4.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "prettier": "^3.9.10",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.71.1"
  }
}
